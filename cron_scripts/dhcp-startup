#!/bin/bash
#
# dhcp-startup — boot launcher for the DHCP server.
#
# This is the ONE file you edit to change how the server starts at boot.
#
# It starts the main server (misc/dhcp.conf) plus every extra instance in
# misc/instances/*/dhcp.conf, skipping any that are already running — so it's
# also safe to run by hand after adding an instance.
#
# It runs at boot via /etc/cron.d/dhcp-startup, which `make install` writes to
# point back at THIS file (`@reboot root <repo>/cron_scripts/dhcp-startup`).
# Because the cron entry points here, editing this file takes effect on the
# next boot with no reinstall.
#
# The script is self-locating (it derives the repo path from its own location),
# so it runs unchanged on any machine, from any checkout path.

# cron's @reboot environment is minimal; give ourselves a sane PATH so setsid,
# date, etc. resolve.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# --- Locate the repo (no hardcoded paths) ----------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"

BIN="$REPO/bin/dhcp_server"
CONF="$REPO/misc/dhcp.conf"
RUNLOG="$REPO/misc/server.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') dhcp-startup: $*" >> "$RUNLOG"; }

if [ ! -x "$BIN" ]; then
    log "ERROR: server binary missing or not executable: $BIN (did you run 'make'?)"
    exit 1
fi

# Start one server unless its pid file points at a live process.  Detached from
# cron's process group (setsid + &) so it keeps running after this launcher and
# cron exit. Root is needed only to bind port 67 (and 647) — the server drops to
# an unprivileged user itself if `user` is set in its config.
launch() {
    local conf="$1" pidfile runlog pid
    pidfile=$(awk '$1 == "pid" { print $2 }' "$conf" | tail -1)
    runlog=$(awk '$1 == "log" { print $2 }' "$conf" | tail -1)
    runlog="${runlog:-$RUNLOG}"
    if [ -n "$pidfile" ] && [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "already running (pid $pid): $conf"
            return
        fi
    fi
    log "starting dhcp_server: $BIN $conf"
    echo "starting: $conf"
    setsid "$BIN" "$conf" >> "$runlog" 2>&1 < /dev/null &
}

# The main server, then every extra cluster node on this machine
# (misc/instances/<ID>/dhcp.conf — created by `make instance`)
launch "$CONF"
for inst in "$REPO"/misc/instances/*/dhcp.conf; do
    [ -f "$inst" ] && launch "$inst"
done
