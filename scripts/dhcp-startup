#!/bin/bash
#
# dhcp-startup — boot launcher and watchdog for the DHCP server.
#
# This is the ONE file you edit to change how the server starts at boot.
#
# It starts the main server (config/dhcp.conf) plus every extra instance in
# etc/instances/*/dhcp.conf, skipping any that are already running — so it's
# also safe to run by hand after adding an instance.
#
# /etc/cron.d/dhcp-startup, which `make install` writes, runs it at boot
# (@reboot) and again every 5 minutes, so a server that has died is restarted.
# Because the cron entries point back at THIS file, editing it takes effect on
# the next run with no reinstall.
#
# The script is self-locating (it derives the repo path from its own location),
# so it runs unchanged on any machine, from any checkout path.

# cron's environment is minimal; give ourselves a sane PATH so setsid, ip,
# date, etc. resolve.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# --- Locate the repo (no hardcoded paths) ----------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"

BIN="$REPO/bin/dhcp_server"
CONF="$REPO/config/dhcp.conf"
RUNLOG="$REPO/etc/server.log"
IP_WAIT_SECS=60

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') dhcp-startup: $*" >> "$RUNLOG"; }

# Root is needed to bind port 67, and to read /proc/<pid>/exe of the running
# (root-owned) server — without it every server would look "not running".
if [ "$(id -u)" -ne 0 ]; then
    echo "dhcp-startup: must run as root (sudo $0)" >&2
    exit 1
fi

# Everything under config/ and etc/ belongs to the checkout's owner — the server drops to
# that user (`user` in dhcp.conf) and nightly maintenance runs as it — so logs
# and backups can be read and deleted without sudo.  This launcher runs as
# root, and so do a few things around it (cron's redirect of its stderr, a
# server from before `user` was set), so hand anything root-created back.
# -h: never follow a symlink.
OWNER="$(stat -c '%U:%G' "$REPO")"
fix_owner() {
    if [ -n "$(find "$REPO/config" "$REPO/etc" ! -user "${OWNER%%:*}" -print -quit 2>/dev/null)" ]; then
        chown -R -h "$OWNER" "$REPO/config" "$REPO/etc"
    fi
}
fix_owner

if [ ! -x "$BIN" ]; then
    log "ERROR: server binary missing or not executable: $BIN (did you run 'make'?)"
    exit 1
fi
BIN_REAL="$(readlink -f "$BIN")"

# The boot run and the 5-minute watchdog run can overlap (the boot run may sit
# waiting for the network); only one launcher at a time.  The lock is taken on
# this script itself, opened read-only: we run as root in a directory a normal
# user can write to, so opening a lock file there for writing would let a
# planted symlink make root clobber any file on the system.
exec 9< "${BASH_SOURCE[0]}"
if ! flock -n 9; then
    echo "another dhcp-startup is already running"
    exit 0
fi

# Is $1 the PID of a running dhcp_server?  A bare `kill -0` isn't enough: PIDs
# repeat almost exactly from one boot to the next, so after an unclean
# shutdown the stale pid file can name an unrelated process that happens to
# have the same PID — and the server would never be started.
is_server_pid() {
    local pid="$1" exe
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
    [ "${exe% (deleted)}" = "$BIN_REAL" ]    # "(deleted)" after a rebuild
}

# cron's @reboot fires before NetworkManager has given the interfaces their
# addresses.  Give server_ip a while to appear so the server can bind it; after
# that start anyway (a single server still works on the shared socket, and a
# cluster node will log why it couldn't start).
wait_for_address() {
    local addr="$1" i
    [ -n "$addr" ] || return 0
    for ((i = 0; i < IP_WAIT_SECS; i++)); do
        ip -4 -o addr show | grep -q " inet $addr/" && return 0
        sleep 1
    done
    log "WARNING: $addr still isn't on any interface after ${IP_WAIT_SECS}s — starting anyway"
}

# Start one server unless its pid file points at a live dhcp_server.  Detached
# from cron's process group (setsid + &) so it keeps running after this
# launcher and cron exit.  The server drops to an unprivileged user itself if
# `user` is set in its config.
launch() {
    local conf="$1" pidfile runlog server_ip pid
    pidfile=$(awk '$1 == "pid" { print $2 }' "$conf" | tail -1)
    runlog=$(awk '$1 == "log" { print $2 }' "$conf" | tail -1)
    runlog="${runlog:-$RUNLOG}"
    server_ip=$(awk '$1 == "server_ip" { print $2 }' "$conf" | tail -1)
    if [ -n "$pidfile" ] && [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile")
        if is_server_pid "$pid"; then
            echo "already running (pid $pid): $conf"
            return
        fi
        log "stale pid file $pidfile (pid $pid is not dhcp_server) — starting"
    fi
    wait_for_address "$server_ip"
    log "starting dhcp_server: $BIN $conf"
    echo "starting: $conf"
    fix_owner                    # incl. the log line just written as root
    # 9>&- : the server mustn't inherit the lock, or it would hold it forever
    setsid "$BIN" "$conf" >> "$runlog" 2>&1 < /dev/null 9>&- &
}

# The main server, then every extra cluster node on this machine
# (etc/instances/<ID>/dhcp.conf — created by `make instance`)
launch "$CONF"
for inst in "$REPO"/etc/instances/*/dhcp.conf; do
    [ -f "$inst" ] && launch "$inst"
done
